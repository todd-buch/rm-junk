{
  "version": 1,
  "scan": {
    "includeHomeLibraryCaches": true,
    "includeLeftoverAppData": true,
    "includeLargeFiles": true,
    "includeOldInstallers": true,
    "includeLogs": true,
    "includeDeveloperJunk": true,
    "includeMailAttachments": false,
    "includeTrashBins": true,
    "includeDuplicates": false,
    "cacheMinBytes": 52428800,
    "cacheMinAgeDays": 3,
    "logMinAgeDays": 30,
    "logMinBytes": 0,
    "devJunkMinBytes": 52428800,
    "devJunkMinAgeDays": 30,
    "mailAttachmentMinBytes": 5242880,
    "mailAttachmentMinAgeDays": 30,
    "trashMinBytes": 0,
    "trashMinAgeDays": 7,
    "duplicateMinBytes": 1048576,
    "largeFileMinGB": 50,
    "largeFileRoots": [
      "~/Library",
      "~/.docker",
      "~/.vagrant.d",
      "~/.cache",
      "~/.local",
      "~/Parallels",
      "~/VirtualBox VMs"
    ],
    "installerMinBytes": 104857600,
    "installerMinAgeDays": 30,
    "maxDepth": 4,
    "followSymlinks": false,
    "minConfidenceForQueue": "medium",
    "workers": 0
  },
  "excludePaths": [
    "~/Documents",
    "~/Desktop",
    "~/Pictures",
    "~/Movies",
    "~/Music"
  ],
  "whitelist": [],
  "deletion": {
    "moveToTrash": true,
    "confirmEachItem": true
  }
}
